{
  "name": "kyuch",
  "version": "0.8.0",
  "description": "Kyuch - a KeePass-compatible password manager",
  "main": "main.js",
  "scripts": {
    "test": "node --test test/core.test.js test/updater.test.js test/totp.test.js test/themes.test.js test/browsers.test.js",
    "start": "electron .",
    "deb": "bash scripts/build-deb.sh",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "private": "true",
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "kdbxweb": "^2.1.1"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "productName": "Kyuch",
  "overrides": {
    "@xmldom/xmldom": "0.8.15"
  },
  "build": {
    "appId": "com.noswear.kyuch",
    "productName": "Kyuch",
    "copyright": "Copyright (c) NoSwear32",
    "directories": {
      "output": "dist-win"
    },
    "files": [
      "main.js",
      "preload.js",
      "core.js",
      "totp.js",
      "browsers.js",
      "argon2-worker.js",
      "autotype.js",
      "updater.js",
      "update-key.pub",
      "icon.png",
      "win_type.ps1",
      "renderer/**/*"
    ],
    "asarUnpack": [
      "win_type.ps1"
    ],
    "electronLanguages": [
      "en-US",
      "en-GB",
      "de"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png",
      "artifactName": "Kyuch-${version}-win.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Kyuch-Setup-${version}.exe",
      "shortcutName": "Kyuch",
      "uninstallDisplayName": "Kyuch",
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "onlyLoadAppFromAsar": true
    }
  }
}
